<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Night is the portal's own palette, lightened. The portal has no dark theme of its own: its
      cards stay #F7F8F8 and its text navy even under prefers-color-scheme: dark, and only the map
      switches. So the two brand colours keep their hue and saturation and move up in lightness
      (#9C0C35 is H343 S86 L33, here L52; #1A3E70 is H215 S62 L27, here L70), and the surfaces come
      from the dark map style the portal serves at /karto/style-dark.json.
    -->
    <color name="brand_red">#EE1C57</color>
    <color name="brand_red_soft">#680823</color>
    <color name="brand_blue">#83ABE2</color>
    <color name="brand_blue_soft">#15325B</color>
    <color name="on_brand">#FFFFFF</color>

    <color name="bg">#0A1526</color>
    <color name="surface">#132038</color>
    <color name="tile">#132038</color>
    <color name="track">#1F3050</color>
    <color name="divider">#1F3050</color>
    <color name="text_primary">#F7F8F8</color>
    <color name="text_secondary">#9DAFC7</color>
    <color name="log_text">#C3C9D4</color>
</resources>
