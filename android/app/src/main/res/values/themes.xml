<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TrainWifi" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorPrimary">@color/brand_red</item>
        <item name="android:colorAccent">@color/brand_red</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:colorEdgeEffect">@color/brand_red</item>
    </style>

    <style name="Button.Primary" parent="@android:style/Widget.DeviceDefault.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/on_brand</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
    </style>

    <style name="Button.Secondary" parent="Button.Primary">
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:textColor">@color/brand_red</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="Button.Small" parent="Button.Secondary">
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Text.Label" parent="@android:style/TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <style name="Text.Section" parent="@android:style/TextAppearance.DeviceDefault.Medium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Body" parent="@android:style/TextAppearance.DeviceDefault.Small">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.StatValue" parent="@android:style/TextAppearance.DeviceDefault.Large">
        <item name="android:textColor">@color/brand_red</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
